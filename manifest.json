{
  "manifest_version": 3,
  "name": "WhatsApp Web Privacy Shield",
  "version": "1.0.0",
  "description": "A local visual privacy layer for WhatsApp Web when using your browser in public.",
  "permissions": ["storage", "activeTab", "tabs"],
  "host_permissions": ["https://web.whatsapp.com/*"],
  "action": {
    "default_title": "WhatsApp Privacy Shield",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://web.whatsapp.com/*"],
      "js": ["content.js"],
      "css": ["privacy.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}